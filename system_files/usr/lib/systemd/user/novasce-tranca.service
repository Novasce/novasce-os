[Unit]
Description=Novasce OS: na sede, a conta pessoal tranca sem uso e a TV volta à Sala
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=/usr/bin/grep -qx sede /etc/novasce/papel
ExecStart=/usr/bin/novasce-tranca
Restart=on-failure

[Install]
WantedBy=graphical-session.target
