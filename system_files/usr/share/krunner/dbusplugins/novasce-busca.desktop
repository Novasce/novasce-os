[Desktop Entry]
Name=Novasce
Comment=Notas do brain e ajuda da Novasce
Icon=novasce-logo
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
X-KDE-PluginInfo-Name=novasce-busca
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-API-Minimum-Version=2.0
X-Plasma-DBusRunner-Service=org.novasce.Barra
X-Plasma-DBusRunner-Path=/busca
X-Plasma-Request-Actions-Once=true
