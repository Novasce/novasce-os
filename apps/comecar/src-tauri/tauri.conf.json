{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "novasce-comecar",
  "version": "0.1.0",
  "identifier": "org.novasce.comecar",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1421", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [{ "label": "principal", "title": "Começar", "width": 1060, "height": 576, "minWidth": 960, "minHeight": 560, "visible": false, "center": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
