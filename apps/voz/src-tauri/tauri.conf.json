{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "novasce-voz",
  "version": "0.1.0",
  "identifier": "org.novasce.voz",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1423", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [{ "label": "painel", "title": "Voz", "width": 420, "height": 48, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "resizable": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
